RewriteEngine On

RewriteRule ^users/new/?$ user.php?novo=1 [QSA,L]
RewriteRule ^users/([a-f0-9]{24})/?$ user.php?id=$1 [QSA,L,NC]

# Serve pages PHP without exposing their extension in the public URL.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Keep a single canonical URL for each page.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[?\s] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]
