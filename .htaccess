RewriteEngine On

RewriteRule ^login\.php$ /login [R=301,L,NE]
RewriteRule ^users\.php$ /users [R=301,L,NE]
RewriteRule ^user\.php$ /users [R=301,L,NE]

RewriteRule ^login/?$ pages/login.php [L]
RewriteRule ^users/new/?$ pages/user.php?novo=1 [QSA,L]
RewriteRule ^users/([a-f0-9]{24})/?$ pages/user.php?id=$1 [QSA,L,NC]
RewriteRule ^users/?$ pages/users.php [L]
RewriteRule ^config/config\.php$ - [L]

# Serve pages PHP without exposing their extension in the public URL.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Keep a single canonical URL for each page.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[?\s] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]
